{
    "name": "omnipay/eway",
    "type": "library",
    "description": "eWAY driver for the Omnipay payment processing library",
    "keywords": [
        "eway",
        "gateway",
        "merchant",
        "omnipay",
        "pay",
        "payment"
    ],
    "homepage": "https://github.com/thephpleague/omnipay-eway",
    "license": "MIT",
    "authors": [
        {
            "name": "Adrian Macneil",
            "email": "adrian@adrianmacneil.com"
        },
        {
            "name": "Omnipay Contributors",
            "homepage": "https://github.com/thephpleague/omnipay-eway/contributors"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omnipay\\Eway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnipay\\Eway\\Tests\\": "tests/"
        }
    },
    "require": {
        "omnipay/common": "^3"
    },
    "require-dev": {
        "omnipay/tests": "^4.2",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "support": {
        "issues": "https://github.com/thephpleague/omnipay-eway/issues",
        "source": "https://github.com/thephpleague/omnipay-eway/tree/master"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php vendor/bin/phpcs",
        "analyse": "@php vendor/bin/phpstan analyse",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
