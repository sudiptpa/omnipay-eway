<?xml version="1.0"?>
<ruleset name="omnipay-eway">
    <description>Code style rules for omnipay-eway.</description>

    <file>src</file>
    <file>tests</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
